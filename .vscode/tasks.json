{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "build",
			"command": "g++",
			"args": [
				"-o",
				"main.exe",
				"main.cpp",
				"eniesLobby.cpp",
				"-I",
				".",
				"-std=c++11"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}